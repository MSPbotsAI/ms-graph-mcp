# Optional overrides — graph-mcp has no required env vars.
# All authentication is per-request via the X-Ms-Graph-Token request header.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Override for sovereign clouds (GCC High, DoD, China 21Vianet)
# GRAPH_BASE_URL=https://graph.microsoft.us/v1.0

# Hosts graph_send_mail may download content_url attachments from
# (comma separated, https only). Default: the Agent platform. Empty = disabled.
# ATTACHMENT_FETCH_ALLOWED_HOSTS=agent.mspbots.ai,agentint.mspbots.ai
